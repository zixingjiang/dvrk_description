<?xml version="1.0" ?>
<robot name="banner" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Example 11: Banner -->
    <!-- This example spawns the scene shown in images/banner.png -->

    <xacro:include filename="$(find dvrk_description)/urdf/include/classic/suj.macro.xacro"/>
    <xacro:include filename="$(find dvrk_description)/urdf/include/classic/ecm.macro.xacro"/>
    <xacro:include filename="$(find dvrk_description)/urdf/include/classic/psm.macro.xacro"/>
    <xacro:include filename="$(find dvrk_description)/urdf/include/classic/mtm.macro.xacro"/>
    <xacro:include filename="$(find dvrk_description)/urdf/include/si/suj.macro.xacro"/>
    <xacro:include filename="$(find dvrk_description)/urdf/include/si/ecm.macro.xacro"/>
    <xacro:include filename="$(find dvrk_description)/urdf/include/si/psm.macro.xacro"/>

    <link name="world"/>

    <xacro:suj_classic
        prefix="Classic_SUJ_" 
        parent_link="world" 
        include_ecm="true" 
        include_psm1="true" 
        include_psm2="true" 
        include_psm3="true" 
        xyz="0 -2 0" 
        rpy="0 0 0"/>
    <xacro:ecm_classic 
        prefix="Classic_ECM_" 
        parent_link="Classic_SUJ_ecm_mount_link"/>
    <xacro:psm_classic 
        prefix="Classic_PSM1_" 
        parent_link="Classic_SUJ_psm1_mount_link"/>
    <xacro:psm_classic 
        prefix="Classic_PSM2_" 
        parent_link="Classic_SUJ_psm2_mount_link"/>  
    <xacro:psm_classic 
        prefix="Classic_PSM3_" 
        parent_link="Classic_SUJ_psm3_mount_link"/>   


    <xacro:suj_si
        prefix="Si_SUJ_"
        parent_link="world"
        include_ecm="true"
        include_psm1="true"
        include_psm2="true"
        include_psm3="true"
        xyz="0 2 0" 
        rpy="0 0 0"/>
    <xacro:ecm_si
        prefix="Si_ECM_"
        parent_link="Si_SUJ_ecm_mount_link"/>
    <xacro:psm_si
        prefix="Si_PSM1_"
        parent_link="Si_SUJ_psm1_mount_link"/>
    <xacro:psm_si
        prefix="Si_PSM2_"
        parent_link="Si_SUJ_psm2_mount_link"/>
    <xacro:psm_si
        prefix="Si_PSM3_"
        parent_link="Si_SUJ_psm3_mount_link"/>


    <xacro:surgeon_console_classic 
        prefix="" 
        parent_link="world" 
        xyz="0 0 0" 
        rpy="0 0 0"/>


</robot>
