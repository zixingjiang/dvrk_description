<?xml version="1.0" ?>
<robot name="dvrk-si" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Example 09: Patient Cart Si -->
    <!-- This example spawns a complete patient cart with three PSMs and an ECM (Si generation) -->

    <xacro:include filename="$(find dvrk_description)/urdf/include/si/suj.macro.xacro"/>
    <xacro:include filename="$(find dvrk_description)/urdf/include/si/ecm.macro.xacro"/>
    <xacro:include filename="$(find dvrk_description)/urdf/include/si/psm.macro.xacro"/>

    <link name="world"/>
    
    <xacro:property name="SUJ_PREFIX" value="SUJ_" />

    <xacro:suj_si
        prefix="${SUJ_PREFIX}"
        parent_link="world"
        include_ecm="true"
        include_psm1="true"
        include_psm2="true"
        include_psm3="true"
        xyz="0 0 0" 
        rpy="0 0 0"/>
    
    <xacro:ecm_si
        prefix="ECM_"
        parent_link="${SUJ_PREFIX}ecm_mount_link"/>

    <xacro:psm_si
        prefix="PSM1_"
        tool="lnd_8mm"
        parent_link="${SUJ_PREFIX}psm1_mount_link"/>

    <xacro:psm_si
        prefix="PSM2_"
        tool="lnd_8mm"
        parent_link="${SUJ_PREFIX}psm2_mount_link"/>

    <xacro:psm_si
        prefix="PSM3_"
        tool="lnd_8mm"
        parent_link="${SUJ_PREFIX}psm3_mount_link"/>


</robot>
