<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find dvrk_description)/urdf/include/colors.xacro"/>
    <xacro:include filename="$(find dvrk_description)/urdf/include/si/tool.macro.xacro"/>

    <!-- Macro for a PSM with tool -->
    <xacro:macro name="psm_si" params="prefix show_RCM:='false' tool:='lnd_8mm' parent_link xyz:='0 0 0' rpy:= '0 0 0'">
        <xacro:psm_arm_si
            prefix='${prefix}'
            show_RCM='${show_RCM}'
            parent_link='${parent_link}'
            xyz='${xyz}'
            rpy='${rpy}'/>
        <xacro:if value="${tool == 'lnd_8mm'}">
            <xacro:tool_lnd_8mm_si
                prefix='${prefix}'
                parent_link='${prefix}tool_mount_link'/>
        </xacro:if>
    </xacro:macro>

    <!-- Macro for a PSM without tool -->
    <xacro:macro name="psm_arm_si" params="prefix show_RCM:='false' parent_link xyz:='0 0 0' rpy:= '0 0 0'">
        <xacro:psm_ecm_body_si
            prefix='${prefix}'
            show_RCM='${show_RCM}'
            parent_link='${parent_link}'
            xyz='${xyz}'
            rpy='${rpy}'/>
        <link name='${prefix}insertion_link'>
            <visual>
                <origin xyz="0 0 0" rpy="${pi} 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/insertion.stl"/>
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi} 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/insertion.stl"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.46526"/>
                <origin xyz="0.00016296 -0.058844 0.0" rpy="0 0 0"/>
                <inertia ixx="0.00020925" ixy="1.7636E-07" ixz="0.0" iyy="0.00043221" iyz="0.0" izz="0.00043221" />
            </inertial>
        </link>
        <joint name='${prefix}insertion_joint' type='prismatic'>
            <parent link='${prefix}pitch3_link'/>
            <child link='${prefix}insertion_link'/>
            <origin xyz='-0.41911 -0.05061 0' rpy='0 ${pi/2} 0'/>
            <axis xyz='0 0 1'/>
            <limit lower='0.0' upper='0.2987' effort='10' velocity='0.02'/>
        </joint>
        <!-- virtual tool mount link -->
        <link name="${prefix}tool_mount_link"/>
        <joint name='${prefix}tool_mount_joint' type='fixed'>
            <parent link='${prefix}insertion_link'/>
            <child link='${prefix}tool_mount_link'/>
            <origin xyz='0 -0.0267 0.1249' rpy='0 0 0'/>
        </joint>
    </xacro:macro>

    <!-- Macro for the PSM/ECM main structure -->
    <xacro:macro name="psm_ecm_body_si" params="prefix show_RCM:='false' parent_link xyz:='0 0 0' rpy:= '0 0 0'">
        <link name='${prefix}base_link'>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/base.stl"/>
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/base.stl"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="1.5188"/>
                <origin xyz="-0.080771 2.1131E-08 1.8613E-07" rpy="0 0 0"/>
                <inertia ixx="0.002395" ixy="-2.6476E-18" ixz="-1.3484E-18" iyy="0.0040794" iyz="4.2598E-10" izz="0.0043778" />
            </inertial>
        </link>
        <link name='${prefix}roll_link'>
            <visual>
                <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/roll.stl"/>
                </geometry>
                <material name="DaVinciMedGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/roll.stl"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="1.7571"/>
                <origin xyz="-0.024957 0.090363 -0.1461" rpy="0 0 0"/>
                <inertia ixx="0.020795" ixy="0.00070407" ixz="-0.0045945" iyy="0.019686" iyz="0.0035267" izz="0.0049404" />
            </inertial>
        </link>
        <link name="${prefix}pitch1_link">
            <visual>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/pitch1.stl"/>
                </geometry>
                <material name="DaVinciMedGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/pitch1.stl"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="4.017"/>
                <origin xyz="0.034755 -0.14928 0.00016296" rpy="0 0 0"/>
                <inertia ixx="0.01469" ixy="0.0011164" ixz="-0.0002464" iyy="0.025616" iyz="-8.5164E-05" izz="0.026307" />
            </inertial>
        </link>
        <link name="${prefix}pitch2_link">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/pitch2.stl"/>
                </geometry>
                <material name="DaVinciMedGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/pitch2.stl"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="2.1982"/>
                <origin xyz="0.11824 -0.12932 1.9336E-19" rpy="0 0 0"/>
                <inertia ixx="0.0076428" ixy="0.0074855" ixz="-2.8207E-19" iyy="0.026585" iyz="1.4256E-19" izz="0.032839" />
            </inertial>
        </link>
        <link name="${prefix}pitch3_link">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/pitch3.stl"/>
                </geometry>
                <material name="DaVinciMedGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/si/psm_ecm/pitch3.stl"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.75206"/>
                <origin xyz="-0.13651 -0.041219 -9.0734E-08" rpy="0 0 0"/>
                <inertia ixx="0.00039277" ixy="0.00048607" ixz="1.7077E-08" iyy="0.018546" iyz="-3.3933E-09" izz="0.018573" />
            </inertial>
        </link>
        <joint name='${prefix}base_joint' type='fixed'>
            <parent link='${parent_link}'/>
            <child link='${prefix}base_link'/>
            <origin xyz='${xyz}' rpy='${rpy}'/>
        </joint>
        <joint name='${prefix}roll_joint' type='revolute'>
            <parent link='${prefix}base_link'/>
            <child link='${prefix}roll_link'/>
            <origin xyz='0.158 0 0' rpy='0 ${-pi/2} 0'/>
            <axis xyz='0 0 1'/>
            <limit lower='${-pi}' upper='${pi}' effort='10' velocity='1.0'/>
        </joint>
        <joint name='${prefix}pitch_joint' type='revolute'>
            <parent link='${prefix}roll_link'/>
            <child link='${prefix}pitch1_link'/>
            <origin xyz='-0.071222 0 -0.2987' rpy='${-pi/2} ${-pi/2+1.1345} 0'/>
            <axis xyz='0 0 1'/>
            <limit lower='${-1.28}' upper='${pi/2}' effort='10' velocity='1.0'/>
        </joint>
        <joint name='${prefix}pitch_mimic1_joint' type='revolute'>
            <parent link='${prefix}pitch1_link'/>
            <child link='${prefix}pitch2_link'/>
            <origin xyz='0.2032 0 0' rpy='0 0 ${pi-0.90761}'/>
            <axis xyz='0 0 1'/>
            <limit lower='${-pi}' upper='${pi}' effort='10' velocity='1.0'/>
            <mimic joint='${prefix}pitch_joint' multiplier='-1.0'/>
        </joint>
        <joint name='${prefix}pitch_mimic2_joint' type='revolute'>
            <parent link='${prefix}pitch2_link'/>
            <child link='${prefix}pitch3_link'/>
            <origin xyz='0.35966 -0.16013 0' rpy='0 0 ${pi/2-0.063963}'/>
            <axis xyz='0 0 1'/>
            <limit lower='${-pi}' upper='${pi}' effort='10' velocity='1.0'/>
            <mimic joint='${prefix}pitch_joint' multiplier='1.0'/>
        </joint>
        <link name='${prefix}RCM_link'>
            <xacro:if value="${show_RCM}">
                <visual>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <sphere radius="0.01"/>
                    </geometry>
                    <material name="">
                        <color rgba="1 0 0 1" />
                    </material>
                </visual>
            </xacro:if>
        </link>
        <joint name='${prefix}RCM_joint' type='fixed'>
            <parent link='${prefix}pitch3_link'/>
            <child link='${prefix}RCM_link'/>
            <origin xyz='0.1731 -0.10643 0.0' rpy='0 0 0'/>
        </joint>
    </xacro:macro>

</robot>