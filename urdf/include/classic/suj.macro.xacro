<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find dvrk_description)/urdf/include/colors.xacro"/>

    <!-- Macro for the complete SUJ -->
    <xacro:macro name='suj' params="prefix include_ecm:=false include_psm1:=false include_psm2:=false include_psm3:=false parent_link xyz:='0 0 0' rpy:='0 0 0'">
        <xacro:suj_tower prefix="${prefix}" parent_link="${parent_link}" xyz="${xyz}" rpy="${rpy}"/>
        <xacro:if value="${include_ecm}">
            <xacro:suj_arm type="ecm" prefix="${prefix}ecm_" parent_link="${prefix}suj_arm_ecm_mount_link"/>
        </xacro:if>
        <xacro:if value="${include_psm1}">
            <xacro:suj_arm type="psm1" prefix="${prefix}psm1_" parent_link="${prefix}suj_arm_psm1_mount_link"/>
        </xacro:if>
        <xacro:if value="${include_psm2}">
            <xacro:suj_arm type="psm2" prefix="${prefix}psm2_" parent_link="${prefix}suj_arm_psm2_mount_link"/>
        </xacro:if>
        <xacro:if value="${include_psm3}">
            <xacro:suj_arm type="psm3" prefix="${prefix}psm3_" parent_link="${prefix}suj_arm_psm3_mount_link"/>
        </xacro:if>
    </xacro:macro>

    <!-- Macro for the SUJ tower -->
    <xacro:macro name='suj_tower' params="prefix parent_link xyz:='0 0 0' rpy:='0 0 0'">
        <link name="${prefix}base_link"/>
        <link name="${prefix}tower_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/tower.stl" />
                </geometry>
                <material name="DaVinciBlue"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/tower.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 -0.163432953037324 0.552457766148795" rpy="0 0 0" />
                <mass value="251.331338880703" />
                <inertia ixx="116.092010218379" ixy="0" ixz="0" iyy="116.786187825287" iyz="-2.79449977491914" izz="20.7204503058012" />
            </inertial>
        </link>
        <link name="${prefix}suj_arm_ecm_mount_link"/>
        <link name="${prefix}suj_arm_psm1_mount_link"/>
        <link name="${prefix}suj_arm_psm2_mount_link"/>
        <link name="${prefix}suj_arm_psm3_mount_link"/>
        <joint name="${prefix}base_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="${prefix}base_link"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>
        <joint name="${prefix}tower_joint" type="fixed">
            <parent link="${prefix}base_link"/>
            <child link="${prefix}tower_link"/>
            <origin xyz="0.101313 0 0.16599999368190765" rpy="0 0 0"/>
        </joint>
        <joint name="${prefix}suj_arm_ecm_mount_joint" type="fixed">
            <parent link="${prefix}tower_link"/>
            <child link="${prefix}suj_arm_ecm_mount_link"/>
            <origin xyz="0.0896 0 0.7611" rpy="0 0 0"/>
        </joint>
        <joint name="${prefix}suj_arm_psm1_mount_joint" type="fixed">
            <parent link="${prefix}tower_link"/>
            <child link="${prefix}suj_arm_psm1_mount_link"/>
            <origin xyz="-0.1016 0.1912 0.7611" rpy="0 0 ${pi/2}"/>
        </joint>
        <joint name="${prefix}suj_arm_psm2_mount_joint" type="fixed">
            <parent link="${prefix}tower_link"/>
            <child link="${prefix}suj_arm_psm2_mount_link"/>
            <origin xyz="-0.1016 -0.1912 0.7611" rpy="0 0 ${-pi/2}"/>
        </joint>
        <joint name="${prefix}suj_arm_psm3_mount_joint" type="fixed">
            <parent link="${prefix}tower_link"/>
            <child link="${prefix}suj_arm_psm3_mount_link"/>
            <origin xyz="0.0896 0 0.3813" rpy="0 0 0"/>
        </joint>
    </xacro:macro>


    <!-- Macro for the SUJ arm -->
    <xacro:macro name='suj_arm' params="prefix type parent_link xyz:='0 0 0' rpy:='0 0 0'">
        <!-- ECM -->
        <xacro:if value="${type == 'ecm'}">
            <xacro:suj_arm_ecm prefix="${prefix}" parent_link="${parent_link}" xyz="${xyz}" rpy="${rpy}"/>
        </xacro:if>
        <!-- PSM1 or PSM2 -->
        <xacro:if value="${type == 'psm1' or type == 'psm2'}">
            <xacro:suj_arm_psm12 prefix="${prefix}" parent_link="${parent_link}" xyz="${xyz}" rpy="${rpy}"/>
        </xacro:if>
        <!-- PSM3 -->
        <xacro:if value="${type == 'psm3'}">
            <xacro:suj_arm_psm3 prefix="${prefix}" parent_link="${parent_link}" xyz="${xyz}" rpy="${rpy}"/>
        </xacro:if>
    </xacro:macro>


    <!-- Macro for the SUJ arm for mounting the ECM -->
    <xacro:macro name='suj_arm_ecm' params="prefix parent_link xyz:='0 0 0' rpy:='0 0 0'">
        <link name="${prefix}lift_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 ${pi} 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/lift_taller.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 ${pi} 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/lift_taller.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.0568399826690054 0 -0.148466700879736" rpy="0 0 0" />
                <mass value="8.19045158700106" />
                <inertia ixx="0.0849399138017188" ixy="0" ixz="-0.00950408519583733" iyy="0.0840388037894653" iyz="0" izz="0.0337578517914834" />
            </inertial>
        </link>
        <link name="${prefix}yaw1_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw1.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw1.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.181423473764043 0 0.108873680906329" rpy="0 0 0" />
                <mass value="4.28515446843305" />
                <inertia ixx="0.0318879130435779" ixy="0" ixz="0.0216382058279063" iyy="0.165298975805323" iyz="0" izz="0.151812373014209" />
            </inertial>
        </link>
        <link name="${prefix}yaw2_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw2.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw2.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.208919873467034 0 0.0907666144838897" rpy="0 0 0" />
                <mass value="3.37391295638733" />
                <inertia ixx="0.0170495937307872" ixy="0" ixz="0.00102556476360271" iyy="0.122648041664091" iyz="0" izz="0.114779656818464" />
            </inertial>
        </link>
        <link name="${prefix}yaw3_link">
            <visual>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 ${pi}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw3_ecm.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 ${pi}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw3_ecm.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.112524703926997 0 0.0347897227037552" rpy="${-pi/2} 0 ${pi}" />
                <mass value="1.52452930578528" />
                <inertia ixx="0.00475548620176369" ixy="0" ixz="0.000176606973794659" iyy="0.0372012049260" iyz="0" izz="0.0348249826431" />
            </inertial>
        </link>
        <link name="${prefix}mount_link"/>
        <joint name="${prefix}lift_joint" type="prismatic">
            <origin xyz="${xyz}" rpy="${rpy}" />
            <parent link="${parent_link}" />
            <child link="${prefix}lift_link" />
            <axis xyz="0 0 1" />
            <limit lower="-0.3798" upper="0.8425" effort="50" velocity="50" />
        </joint>
        <joint name="${prefix}yaw1_joint" type="revolute">
            <parent link="${prefix}lift_link"/>
            <child link="${prefix}yaw1_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi/2}" upper="${pi/2}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}yaw2_joint" type="revolute">
            <parent link="${prefix}yaw1_link"/>
            <child link="${prefix}yaw2_link"/>
            <origin xyz="0.4318 0 0.17125" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}yaw3_joint" type="revolute">
            <parent link="${prefix}yaw2_link"/>
            <child link="${prefix}yaw3_link"/>
            <origin xyz="0.4318 0 -0.052" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}mount_joint" type="fixed">
            <parent link="${prefix}yaw3_link"/>
            <child link="${prefix}mount_link"/>
            <origin xyz="-0.103 0 -0.173" rpy="0 ${0.2340844537*pi} 0"/>
        </joint>
    </xacro:macro>

    <!-- Macro for the SUJ arm for mounting the PSM1 and PSM2 -->
    <xacro:macro name='suj_arm_psm12' params="prefix parent_link xyz:='0 0 0' rpy:='0 0 0'">
        <link name="${prefix}lift_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 ${pi} 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/lift_taller.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 ${pi} 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/lift_taller.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.0568399826690054 0 -0.148466700879736" rpy="0 0 0" />
                <mass value="8.19045158700106" />
                <inertia ixx="0.0849399138017188" ixy="0" ixz="-0.00950408519583733" iyy="0.0840388037894653" iyz="0" izz="0.0337578517914834" />
            </inertial>
        </link>
        <link name="${prefix}yaw1_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw1.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw1.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.181423473764043 0 0.108873680906329" rpy="0 0 0" />
                <mass value="4.28515446843305" />
                <inertia ixx="0.0318879130435779" ixy="0" ixz="0.0216382058279063" iyy="0.165298975805323" iyz="0" izz="0.151812373014209" />
            </inertial>
        </link>
        <link name="${prefix}yaw2_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw2.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw2.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.208919873467034 0 0.0907666144838897" rpy="0 0 0" />
                <mass value="3.37391295638733" />
                <inertia ixx="0.0170495937307872" ixy="0" ixz="0.00102556476360271" iyy="0.122648041664091" iyz="0" izz="0.114779656818464" />
            </inertial>
        </link>
        <link name="${prefix}yaw3_link">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw3_psm.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw3_psm.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.0299587011265839 0 -0.147369605966979" rpy="${pi/2} 0 ${-pi/2}" />
                <mass value="1.46016558605931" />
                <inertia ixx="0.0128891233532759" ixy="0" ixz="0" iyy="0.00658384974944233" iyz="0.00230089243299317" izz="0.00938095830526967" />
            </inertial>
        </link>
        <link name="${prefix}roll_link">
            <visual>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/roll.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/roll.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0.13368960726033 0.106531287729481" rpy="${-pi/2} 0 ${-pi/2}" />
                <mass value="3.17073043883155" />
                <inertia ixx="0.0814804866545533" ixy="0" ixz="0" iyy="0.0179293368302569" iyz="-0.0218807182526152" izz="0.0668098507562027" />
            </inertial>
        </link>
        <link name="${prefix}mount_link"/>
        <joint name="${prefix}lift_joint" type="prismatic">
            <origin xyz="${xyz}" rpy="${rpy}" />
            <parent link="${parent_link}" />
            <child link="${prefix}lift_link"/>
            <axis xyz="0 0 1" />
            <limit lower="-0.3798" upper="0.8425" effort="50" velocity="50" />
        </joint>
        <joint name="${prefix}yaw1_joint" type="revolute">
            <parent link="${prefix}lift_link"/>
            <child link="${prefix}yaw1_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi/2}" upper="${pi/2}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}yaw2_joint" type="revolute">
            <parent link="${prefix}yaw1_link"/>
            <child link="${prefix}yaw2_link"/>
            <origin xyz="0.4318 0 0.17125" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}yaw3_joint" type="revolute">
            <parent link="${prefix}yaw2_link"/>
            <child link="${prefix}yaw3_link"/>
            <origin xyz="0.4318 0 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}roll_joint" type="revolute">
            <origin xyz="0.061 0 -0.0730499999999998" rpy="0 ${pi/2} ${pi}" />
            <parent link="${prefix}yaw3_link" />
            <child link="${prefix}roll_link" />
            <axis xyz="0 0 1" />
            <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}yaw4_joint" type="revolute">
            <origin xyz="0.1029000019 0 -0.3479" rpy="${pi} ${pi/2} 0"/>
            <parent link="${prefix}roll_link"/>
            <child link="${prefix}mount_link"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
        </joint>
    </xacro:macro>


    <!-- Macro for the SUJ arm for mounting the PSM3 -->
    <xacro:macro name='suj_arm_psm3' params="prefix parent_link xyz:='0 0 0' rpy:='0 0 0'">
        <link name="${prefix}lift_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 ${pi} 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/lift_taller.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 ${pi} 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/lift_taller.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.0568399826690054 0 -0.148466700879736" rpy="0 0 0" />
                <mass value="8.19045158700106" />
                <inertia ixx="0.0849399138017188" ixy="0" ixz="-0.00950408519583733" iyy="0.0840388037894653" iyz="0" izz="0.0337578517914834" />
            </inertial>
        </link>
        <link name="${prefix}yaw1_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw1_longer.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw1_longer.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 -0.269226910798469 0.0974465195036079" rpy="0 0 ${pi/2}" />
                <mass value="9.2143433650029" />
                <inertia ixx="0.512543337774863" ixy="0" ixz="0" iyy="0.046675533244729" iyz="-0.022324667193201" izz="0.500775909008121" />
            </inertial>
        </link>
        <link name="${prefix}yaw2_link">
            <visual>
                <origin xyz="0 0 0" rpy="${pi} 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw2.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi} 0 0" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw2.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.208919873467034 0 0.0907666144838897" rpy="${pi} 0 0" />
                <mass value="3.37391295638733" />
                <inertia ixx="0.0170495937307872" ixy="0" ixz="0.00102556476360271" iyy="0.122648041664091" iyz="0" izz="0.114779656818464" />
            </inertial>
        </link>
        <link name="${prefix}yaw3_link">
            <visual>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 ${pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw3_psm_taller.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 ${pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/yaw3_psm_taller.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 -0.147369605966979 0.0299587011265839" rpy="${-pi/2} 0 ${pi/2}" />
                <mass value="1.46016558605931" />
                <inertia ixx="0.0128891233532759" ixy="0" ixz="0" iyy="0.00658384974944233" iyz="0.00230089243299317" izz="0.00938095830526967" />
            </inertial>
        </link>
        <link name="${prefix}roll_link">
            <visual>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/roll.stl" />
                </geometry>
                <material name="DaVinciLightGray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
                <geometry>
                    <mesh filename="package://dvrk_description/meshes/classic/suj/roll.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0.13368960726033 0.106531287729481" rpy="${-pi/2} 0 ${-pi/2}" />
                <mass value="3.17073043883155" />
                <inertia ixx="0.0814804866545533" ixy="0" ixz="0" iyy="0.0179293368302569" iyz="-0.0218807182526152" izz="0.0668098507562027" />
            </inertial>
        </link>
        <link name="${prefix}mount_link"/>
        <joint name="${prefix}lift_joint" type="prismatic">
            <origin xyz="${xyz}" rpy="${rpy}" />
            <parent link="${parent_link}" />
            <child link="${prefix}lift_link" />
            <axis xyz="0 0 1" />
            <limit lower="0" upper="1.2223" effort="50" velocity="50" />
        </joint>
        <joint name="${prefix}yaw1_joint" type="continuous">
            <parent link="${prefix}lift_link"/>
            <child link="${prefix}yaw1_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi/2}" upper="${pi/2}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}yaw2_joint" type="revolute">
            <parent link="${prefix}yaw1_link"/>
            <child link="${prefix}yaw2_link"/>
            <origin xyz="0.5842 0 -0.00025" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}yaw3_joint" type="revolute">
            <parent link="${prefix}yaw2_link"/>
            <child link="${prefix}yaw3_link"/>
            <origin xyz="0.4318 0 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}roll_joint" type="revolute">
            <origin xyz="0.061 0 0.199949999999999" rpy="0 ${pi/2} ${pi}" />
            <parent link="${prefix}yaw3_link" />
            <child link="${prefix}roll_link" />
            <axis xyz="0 0 1" />
            <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
        </joint>
        <joint name="${prefix}yaw4_joint" type="revolute">
            <origin xyz="0.1029000019 0 -0.3479" rpy="${pi} ${pi/2} 0"/>
            <parent link="${prefix}roll_link"/>
            <child link="${prefix}mount_link"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
        </joint>
    </xacro:macro>

</robot>
